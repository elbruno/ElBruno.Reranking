<div class="card shadow-sm code-sample">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 bg-body-tertiary">
        <div>
            <div class="fw-semibold">@Title</div>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <div class="small text-body-secondary">@Description</div>
            }
        </div>

        <span class="badge text-bg-secondary">@Language</span>
    </div>

    <div class="card-body">
        <pre class="mb-0 code-sample-block"><code>@Code</code></pre>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter, EditorRequired]
    public string Code { get; set; } = string.Empty;

    [Parameter]
    public string Language { get; set; } = "razor";
}
