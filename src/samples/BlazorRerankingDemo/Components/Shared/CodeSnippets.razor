@if (Items.Count > 0)
{
    <div class="card shadow-sm">
        <div class="card-header bg-body-tertiary fw-semibold">@Title</div>

        <div class="list-group list-group-flush">
            @foreach (var item in Items)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@item.Title</div>
                            <div class="small text-body-secondary">@item.Description</div>
                        </div>

                        <span class="badge text-bg-light border text-nowrap">@item.Value</span>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<CodeSnippet> Items { get; set; } = Array.Empty<CodeSnippet>();

    [Parameter]
    public string Title { get; set; } = "Key snippets";
}
