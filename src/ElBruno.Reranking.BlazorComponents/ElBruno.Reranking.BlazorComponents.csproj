<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ElBruno.Reranking.BlazorComponents</RootNamespace>

    <PackageId>ElBruno.Reranking.BlazorComponents</PackageId>
    <Version>0.6.0</Version>
    <Authors>Bruno Capuano</Authors>
    <Description>Blazor components for semantic reranking UIs.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/elbruno/ElBruno.Reranking</RepositoryUrl>
    <PackageProjectUrl>https://github.com/elbruno/ElBruno.Reranking</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElBruno.Reranking\ElBruno.Reranking.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
